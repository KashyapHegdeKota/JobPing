# Copy reviewed values to /etc/jobping/backend.env after applying the migration.
EVIDENCE_WORKER_ENABLED=false
EVIDENCE_RENDERER_URL=http://127.0.0.1:8031
# Optional exact hostname -> canonical hiring entity JSON, never fuzzy aliases.
# Leave unset to disable generic employers. Optional host registry:
# /etc/jobping/evidence/employers.json (read-only worker mount).
EVIDENCE_EMPLOYERS_FILE=
# Frontend build environment (independent of the worker flag):
# NEXT_PUBLIC_SCREENING_ENABLED=false
