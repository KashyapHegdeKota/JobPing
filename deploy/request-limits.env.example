# Copy reviewed values into /etc/jobping/backend.env; never commit the actual secret.
# Defaults are off for development. Observe real traffic before enforcing.
REQUEST_LIMIT_MODE=shadow
# Generate >=32 random bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
REQUEST_LIMIT_SECRET=
REQUEST_LIMIT_TIMEOUT=0.25
REQUEST_LIMIT_STREAMS_PER_IP=20
# Provisional; set after isolated load testing of the one-worker VM deployment.
REQUEST_LIMIT_STREAMS_TOTAL=200
REQUEST_LIMIT_HTTP_CONCURRENCY=32
REQUEST_LIMIT_LEASE_SECONDS=60
REQUEST_LIMIT_CACHE_SECONDS=30
# Optional fixed-family overrides, rate is tokens per second, burst is initial capacity.
REQUEST_LIMIT_POLICIES={}
