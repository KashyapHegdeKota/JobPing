# PostgreSQL development credentials
POSTGRES_DB=jobping
POSTGRES_USER=jobping
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://jobping:change-me-for-local-development@localhost:5432/jobping
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STARTUP_HEALTH_CHECKS=true
GITHUB_OWNER=SimplifyJobs
GITHUB_REPO=Summer2027-Internships
SIMPLIFY_REPOSITORIES=Summer2027-Internships,New-Grad-Positions
GITHUB_REF=main
SIMPLIFY_FULL_SYNC_REF=dev
TARGET_README=README.md
TARGET_READMES=README.md,README-Off-Season.md

# Optional email notifications. Keep sending disabled until setup and dry-run review.
NOTIFICATIONS_SEND_ENABLED=false
NOTIFICATIONS_SUPPRESS_DISCOVERY=false
NOTIFICATION_APP_URL=https://jobping.example
NOTIFICATION_API_URL=https://api.jobping.example
RESEND_FROM=no-reply@jobping.example
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/etc/jobping/firebase-service-account.json
# JSON map of version -> Fernet key; generate and store separately from the database.
NOTIFICATION_KEY_VERSION=v1
NOTIFICATION_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_GENERATED_FERNET_KEY"}
